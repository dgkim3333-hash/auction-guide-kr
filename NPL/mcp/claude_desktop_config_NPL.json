{
  "mcpServers": {
    "korean-law": {
      "command": "npx",
      "args": ["-y", "korean-law-mcp"],
      "env": { "LAW_OC": "<<여기에_국가법령정보센터_OC_입력__이메일_아이디>>" }
    },
    "real-estate": {
      "command": "uv",
      "args": ["run", "--directory", "C:\\AI\\mcp\\real-estate-mcp", "python", "src/real_estate/mcp_server/server.py"],
      "env": {
        "DATA_GO_KR_SERVICE_KEY": "<<여기에_공공데이터포털_일반인증키_Decoding_입력>>",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "datagokr": {
      "command": "uv",
      "args": ["--directory", "C:\\AI\\mcp\\datagokr-mcp", "run", "python", "server.py"],
      "env": {
        "DATA_GO_KR_SERVICE_KEY": "<<여기에_공공데이터포털_일반인증키_Decoding_입력>>",
        "EPOST_SERVICE_KEY": "<<여기에_공공데이터포털_일반인증키_Decoding_입력>>",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "vworld-landuse": {
      "command": "uv",
      "args": ["run", "--directory", "C:\\AI\\mcp\\vworld-landuse-mcp", "python", "vworld_landuse_mcp.py"],
      "env": {
        "VWORLD_API_KEY": "<<여기에_브이월드_인증키_입력>>",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "duckdb": {
      "command": "uvx",
      "args": ["mcp-server-motherduck", "--db-path", "C:\\AI\\경매창고.duckdb", "--read-write"]
    },
    "word": {
      "command": "uvx",
      "args": ["--from", "word-mcp-live", "word_mcp_server.exe"],
      "env": {
        "MCP_AUTHOR": "Claude",
        "MCP_AUTHOR_INITIALS": "C",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@3.25.4"],
      "env": { "FIRECRAWL_API_KEY": "<<여기에_Firecrawl_키_입력__fc-로_시작합니다>>" }
    }
  }
}
